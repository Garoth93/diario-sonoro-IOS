# Xcode project is generated by XcodeGen: never commit it
*.xcodeproj
*.xcworkspace
!*.xcodeproj/project.xcworkspace

# Build output
.build/
build/
DerivedData/
*.ipa
*.xcarchive
*.dSYM.zip

# Swift Package Manager
Package.resolved
.swiftpm/

# macOS / editor
.DS_Store
*.xcuserstate
xcuserdata/
*.swp

# Signing material must never be committed
*.p12
*.mobileprovision
*.p8
*.cer
*.certSigningRequest
AuthKey_*.p8

# Info.plist files are generated by XcodeGen from project.yml
apps/*/Info.plist

# Widget Info.plist generated by XcodeGen
apps/*/*-Info.plist

# Audio and personal data must never be committed (synthetic data only)
*.m4a
*.aac
*.caf
*.wav
*.mp3
*.zip
diary.json
screenshots/
